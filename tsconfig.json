{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./runtime-host/*"]
    }
  },
  "include": [
    "runtime/**/*.d.ts",
    "runtime/**/*.ts",
    "runtime/**/*.tsx",
    "runtime-host/**/*.ts",
    "runtime-host/**/*.tsx",
    "scripts/**/*.mjs"
  ]
}
